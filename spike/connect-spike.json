{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.dbname": "spike",
  "database.user": "spike_cdc",
  "database.password": "${dir:/run/secrets:spike_cdc}",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "insert into chassis_heartbeat (id, at) values (1, now()) on conflict (id) do update set at = now()",
  "topic.prefix": "cdc.spike",
  "slot.name": "cdc_spike",
  "publication.name": "chassis_outbox_pub",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.chassis_outbox,public.chassis_heartbeat",
  "snapshot.mode": "initial",
  "snapshot.select.statement.overrides": "public.chassis_outbox",
  "snapshot.select.statement.overrides.public.chassis_outbox": "select * from public.chassis_outbox order by seq",
  "tombstones.on.delete": "false",
  "predicates": "isOutbox,isMine",
  "predicates.isOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isOutbox.pattern": "cdc\\.spike\\.public\\.chassis_outbox",
  "predicates.isMine.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isMine.pattern": "^(ev\\.spike\\..+|audit\\.spike)$",
  "transforms": "outbox,allow,dropSource,source,spec,ctype",
  "transforms.outbox.predicate": "isOutbox",
  "transforms.allow.type": "org.apache.kafka.connect.transforms.Filter",
  "transforms.allow.predicate": "isMine",
  "transforms.allow.negate": "true",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.route.by.field": "topic",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.table.field.event.key": "aggregateid",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.table.fields.additional.placement": "id:header:ce_id,type:header:ce_type,ce_subject:header,ce_time:header,ce_dataschema:header,ce_tenantid:header,ce_aggregateversion:header,ce_correlationid:header,ce_causationid:header,ce_traceparent:header,ce_authtype:header,ce_authid:header,ce_authclaims:header",
  "transforms.dropSource.type": "org.apache.kafka.connect.transforms.DropHeaders",
  "transforms.dropSource.headers": "ce_source",
  "transforms.source.type": "org.apache.kafka.connect.transforms.InsertHeader",
  "transforms.source.header": "ce_source",
  "transforms.source.value.literal": "spike",
  "transforms.spec.type": "org.apache.kafka.connect.transforms.InsertHeader",
  "transforms.spec.header": "ce_specversion",
  "transforms.spec.value.literal": "\"1.0\"",
  "transforms.ctype.type": "org.apache.kafka.connect.transforms.InsertHeader",
  "transforms.ctype.header": "content-type",
  "transforms.ctype.value.literal": "application/json"
}
