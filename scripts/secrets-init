#!/usr/bin/env bash
# Writes every base secret that doesn't exist yet into ./secrets. Safe to run any number of times.
# Design checkpoint §4.10 (scripts/up step 1) and §4.12b (permissions).
# Usage: scripts/secrets-init [root]   (root defaults to the repository)
set -euo pipefail

root=${1:-"$(cd "$(dirname "$0")/.." && pwd)"}
list="$root/platform/secrets.base.yaml"
dir="$root/secrets"

umask 077
mkdir -p "$dir" "$root/generated"
chmod 0700 "$dir"
# One run at a time, so a certificate and its key always come from the same run.
exec 9> "$dir/.lock"
flock 9
[ -e "$root/generated/fga.env" ] || : > "$root/generated/fga.env"

# Writes $2 to a secret file with no trailing newline, then makes it read-only for everyone.
# Refuses empty content, so a failed generator never leaves an empty secret behind.
put() {
  local file=$1 value=$2 tmp
  [ -n "$value" ] || { echo "secrets-init: empty value for ${file##*/}" >&2; exit 1; }
  tmp=$(mktemp "$dir/.tmp.XXXXXX")
  printf '%s' "$value" > "$tmp"
  chmod 0444 "$tmp"
  mv "$tmp" "$file"
}

# Config files for products that can't read a secret from a file (§4.12b). Each holds secrets
# written above, so it is rendered after them, on every run, and rewritten only when it differs:
# a rotated password then reaches the config too.
# Reads a secret file written above, refusing a missing or empty one.
input() {
  local v
  v=$(cat "$dir/$1") && [ -n "$v" ] || { echo "secrets-init: $1 is missing or empty" >&2; exit 1; }
  printf '%s' "$v"
}

render() {
  local pw key
  case $1 in
    openfga-config)
      # Read by both `openfga migrate` and `openfga run` from /etc/openfga/config.yaml (spec B-5).
      pw=$(input openfga-db) && key=$(input openfga-preshared-key) || exit 1
      cat << EOF
datastore:
  engine: postgres
  uri: postgres://openfga:$pw@postgres:5432/openfga?sslmode=disable
authn:
  method: preshared
  preshared:
    keys:
      - $key
EOF
      ;;
    *)
      echo "secrets-init: no renderer for config '$1'" >&2; exit 1 ;;
  esac
}

# `tr` gets SIGPIPE when `head` has enough, which pipefail would turn into a failure.
password() { (LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom || true) | head -c 32; }

configs=()
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%%#*}
  [[ $line =~ ^[[:space:]]*$ ]] && continue
  name=$(sed -E 's/^[[:space:]]*([A-Za-z0-9._-]+):.*/\1/' <<< "$line")
  kind=$(sed -E 's/^[^:]*:[[:space:]]*([a-z-]+)[[:space:]]*$/\1/' <<< "$line")
  case $kind in
    password)
      if [ ! -e "$dir/$name" ]; then v=$(password); put "$dir/$name" "$v"; fi ;;
    pem-key)
      if [ ! -e "$dir/$name" ]; then v=$(openssl genpkey -algorithm ed25519 2> /dev/null); put "$dir/$name" "$v"; fi ;;
    certificate)
      if [ ! -e "$dir/$name.crt" ] || [ ! -e "$dir/$name.key" ]; then
        key=$(openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 2> /dev/null)
        crt=$(openssl req -x509 -new -days 825 -subj "/O=Setpiece/OU=self-signed by scripts secrets-init/CN=localhost" \
          -key <(printf '%s\n' "$key") 2> /dev/null)
        put "$dir/$name.key" "$key"
        put "$dir/$name.crt" "$crt"
      fi ;;
    config)
      configs+=("$name") ;; # rendered below, once the passwords they hold exist
    *)
      echo "secrets-init: unknown kind '$kind' for '$name' in $list" >&2; exit 1 ;;
  esac
done < "$list"

for name in ${configs[@]+"${configs[@]}"}; do
  v=$(render "$name") || exit 1
  if [ ! -e "$dir/$name" ] || [ "$(cat "$dir/$name")" != "$v" ]; then put "$dir/$name" "$v"; fi
done
