#!/usr/bin/env bash
# Build step 1's checks (E03 spec, requirement Q-1). Each section prints
# PASS, FAIL or NOT RUN per requirement id, with its evidence, and the script
# exits non-zero if any check failed.
# Usage: scripts/spike-check <section>...   Sections: secrets up-version up-order static-config k1 k2 pg kafka k3 k4 k5 telemetry static net up-twice stats
#        scripts/spike-check k1 --from <label> <kong address> <this device's LAN address>   (K-1 (b), off the host)
# Sections that need the running stack use the Compose project in COMPOSE_PROJECT_NAME, if set.
# Functions are called indirectly through section_<name>, which shellcheck cannot see.
# jq programs are single-quoted on purpose (SC2016).
# shellcheck disable=SC2329,SC2016
set -uo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
failed=0

pass()   { printf 'PASS    %-5s %s\n' "$1" "$2"; }
fail()   { printf 'FAIL    %-5s %s\n' "$1" "$2"; failed=1; }
notrun() { printf 'NOT RUN %-5s %s\n' "$1" "$2"; }
check()  { local id=$1 what=$2; shift 2; if "$@"; then pass "$id" "$what"; else fail "$id" "$what"; fi; }

# A throwaway copy of the scripts and platform list, so checks never touch ./secrets.
sandbox() {
  local d
  d=$(mktemp -d)
  mkdir -p "$d/scripts" "$d/platform"
  cp "$repo/scripts/secrets-init" "$repo/scripts/up" "$d/scripts/"
  cp "$repo/platform/secrets.base.yaml" "$repo/platform/services.txt" "$d/platform/"
  cp "$repo/compose.base.yaml" "$d/"
  echo "$d"
}

# Names of base secret files, by kind.
entries() { sed -E 's/#.*//' "$repo/platform/secrets.base.yaml" | grep -E ':' | sed -E 's/[[:space:]]//g'; }
files_of() { entries | awk -F: -v k="$1" '$2 == k { print $1 }'; }

section_secrets() {
  local d h1 h2 f bad fga
  d=$(sandbox)
  "$d/scripts/secrets-init" "$d"
  h1=$(cd "$d/secrets" && sha256sum ./* | sort)
  "$d/scripts/secrets-init" "$d"
  h2=$(cd "$d/secrets" && sha256sum ./* | sort)

  bad=""
  for f in $(files_of password) $(files_of pem-key); do [ -f "$d/secrets/$f" ] || bad+=" $f"; done
  for f in $(files_of certificate); do [ -f "$d/secrets/$f.crt" ] && [ -f "$d/secrets/$f.key" ] || bad+=" $f"; done
  for f in $(files_of config); do [ -f "$d/secrets/$f" ] || bad+=" $f"; done
  check B-1 "every base secret written (missing:${bad:- none})" test -z "$bad"
  check B-1 "second run changes no file" test "$h1" = "$h2"
  check B-1 "generated/fga.env exists and is empty" test -f "$d/generated/fga.env" -a ! -s "$d/generated/fga.env"
  check B-1 "./secrets is git-ignored" git -C "$repo" check-ignore -q secrets/x

  bad=""
  for f in "$d"/secrets/*; do
    [ "$(tail -c1 "$f" | od -An -c | tr -d ' ')" = '\n' ] && bad+=" ${f##*/}"
  done
  check B-2 "no secret file ends in a newline (offenders:${bad:- none})" test -z "$bad"
  bad=""
  for f in $(files_of password); do grep -Eqx '[A-Za-z0-9]{32}' "$d/secrets/$f" || bad+=" $f"; done
  check B-2 "passwords are 32 alphanumeric characters (offenders:${bad:- none})" test -z "$bad"
  bad=""
  for f in $(files_of pem-key); do
    openssl pkey -in "$d/secrets/$f" -noout -text 2> /dev/null | grep -q ED25519 &&
      head -1 "$d/secrets/$f" | grep -q 'BEGIN PRIVATE KEY' || bad+=" $f"
  done
  check B-2 "pem-key files are Ed25519 PKCS#8 (offenders:${bad:- none})" test -z "$bad"

  fga=$d/secrets/openfga-config
  check B-5 "openfga-config holds the openfga-db password and the preshared key" bash -c \
    "grep -qF \"//openfga:\$(cat '$d/secrets/openfga-db')@postgres:5432/openfga?\" '$fga' &&
     grep -qxF \"      - \$(cat '$d/secrets/openfga-preshared-key')\" '$fga'"

  for f in $(files_of certificate); do
    check B-3 "$f.crt subject: $(openssl x509 -in "$d/secrets/$f.crt" -noout -subject 2> /dev/null)" \
      bash -c "openssl x509 -in '$d/secrets/$f.crt' -noout -subject | grep -q self-signed"
  done

  check B-4 "./secrets is 0700 ($(stat -c %a "$d/secrets"))" test "$(stat -c %a "$d/secrets")" = 700
  bad=""
  for f in "$d"/secrets/*; do [ "$(stat -c %a "$f")" = 444 ] || bad+=" ${f##*/}"; done
  check B-4 "every secret file is 0444 (offenders:${bad:- none})" test -z "$bad"
  notrun B-4 "per-container secret mounts: checked as containers arrive (issue OUT-155)"
  rm -rf "$d"
}

# A fake `docker` that records its arguments. FAKE_VERSION sets its answer to `version`.
fake_docker() {
  local bin=$1
  mkdir -p "$bin"
  cat > "$bin/docker" << 'EOF'
#!/usr/bin/env bash
if [ -e secrets/kafka-admin ]; then sec=y; else sec=n; fi
echo "docker $* [secrets=$sec]" >> "$FAKE_LOG"
case " $* " in
  *" version --short "*) echo "$FAKE_VERSION" ;;
esac
EOF
  chmod +x "$bin/docker"
}

section_up_version() {
  local d rc
  d=$(sandbox)
  fake_docker "$d/bin"
  FAKE_LOG="$d/log" FAKE_VERSION=9.9.9 PATH="$d/bin:$PATH" "$d/scripts/up" 2> "$d/err"
  rc=$?
  check A-5 "refuses Compose 9.9.9 (exit $rc: $(cat "$d/err"))" test "$rc" -ne 0
  check A-5 "nothing started: no secrets written, no up call" \
    bash -c "[ ! -e '$d/secrets' ] && ! grep -q ' up ' '$d/log'"
  FAKE_LOG="$d/log2" FAKE_VERSION=v5.5.1 PATH="$d/bin:$PATH" "$d/scripts/up" 2> "$d/err"
  rc=$?
  check A-5 "accepts the pinned version (exit $rc)" test "$rc" -eq 0 -a -f "$d/secrets/kafka-admin"
  rm -rf "$d"
}

section_up_order() {
  local d log
  d=$(sandbox)
  fake_docker "$d/bin"
  # Nothing generated and an empty services list: step 2 only, no fga-init, no step 3.
  : > "$d/platform/services.txt"
  FAKE_LOG="$d/log" FAKE_VERSION=5.5.1 PATH="$d/bin:$PATH" "$d/scripts/up"
  log=$(cat "$d/log")
  check A-2 "no compose.services.yaml: only compose.base.yaml is named" bash -c "! grep -q compose.services.yaml <<< '$log'"
  check A-2 "no fga/fga.mod: fga-init not run" bash -c "! grep -q fga-init <<< '$log'"
  check A-3 "empty services list: one up call, step 2's" bash -c "[ \"\$(grep -c ' up ' <<< '$log')\" = 1 ]"

  # With a stand-in list: step 2 names only postgres and openfga, step 3 names the list, in that order.
  printf 'kong\nedge-auth\n' > "$d/platform/services.txt"
  FAKE_LOG="$d/log2" FAKE_VERSION=5.5.1 PATH="$d/bin:$PATH" "$d/scripts/up"
  log=$(grep ' up ' "$d/log2" | sed 's/ \[secrets=.\]$//')
  local first_up
  first_up=$(grep -m1 ' up ' "$d/log2")
  echo "        calls: $(tr '\n' ';' <<< "$log")"
  check A-3 "step 2 waits on postgres and openfga only, base file only" \
    bash -c "sed -n 1p <<< '$log' | grep -qx 'docker compose -f compose.base.yaml up -d --wait postgres openfga'"
  check A-3 "step 3 waits on platform/services.txt" \
    bash -c "sed -n 2p <<< '$log' | grep -qx 'docker compose -f compose.base.yaml up -d --wait kong edge-auth'"
  check A-3 "no one-shot container after --wait" \
    bash -c "! grep -Eq -- '--wait.*(pg-init|kafka-init|openfga-migrate|fga-init)' <<< '$log'"
  check A-3 "secrets-init ran before the first up ($first_up)" bash -c "grep -q 'secrets=y\]$' <<< '$first_up'"
  rm -rf "$d"
}

section_static_config() {
  local out
  out=$("$repo/scripts/check-compose" 2>&1)
  local rc=$?
  printf '%s\n' "$out" | sed 's/^/        /'
  check K-6d "static compose checks (digests, cap_drop, restart, health check, no literal secrets)" test "$rc" -eq 0
}

# Compose with the test overlay. COMPOSE_PROJECT_NAME, when set, picks the project.
dc() { docker compose -f "$repo/compose.base.yaml" -f "$repo/spike/compose.spike.yaml" "$@"; }
# A jq test over a file of JSON values, quiet.
jqt() { jq -se "$1" "$2" > /dev/null; }
# What the stub edge-auth recorded, read from a probe on `services`.
stub_received() { dc run --rm --no-deps -T probe curl -s http://edge-auth:8080/_stub/received 2> /dev/null; }
# Waits for the start of a new minute, so a rate-limit window is fresh and can't roll over mid-test.
fresh_minute() { sleep $((61 - 10#$(date +%S))); }

section_k1() {
  local d run addr url kong img code out rec ok limited n i
  d=$(mktemp -d)
  if ! (cd "$repo" && scripts/up) > "$d/up.log" 2>&1 || ! dc up -d --wait echo > "$d/echo.log" 2>&1; then
    fail K-1 "stack did not start: $(tail -3 "$d/up.log" "$d/echo.log" | tr '\n' ' ')"
    rm -rf "$d"; return
  fi
  addr=$(dc port kong 8443 | grep -v '^\[' | head -1)
  addr=${addr/0.0.0.0/127.0.0.1}
  url="https://$addr"
  kong=$(dc ps -q kong)
  img=$(dc --profile probe config --format json | jq -r '.services.probe.image')
  run="k1-$(date +%s)-$$"

  # F-1: Kong answers on 443, publishes nothing else, and has no admin API.
  code=$(curl -sk -o /dev/null -w '%{http_code}' "$url/")
  check F-1 "Kong answers on $url (HTTP $code)" test "$code" != 000
  out=$(docker inspect -f '{{json .NetworkSettings.Ports}}' "$kong" |
    jq -r '[to_entries[] | select(.value != null) | "\(.key)->\(.value[].HostPort)"] | unique | join(" ")')
  check F-1 "published ports: $out" test "$out" = "8443/tcp->443"
  # From inside Kong's network namespace: the proxy port answers, the admin ports refuse (curl exit 7).
  inside() { docker run --rm --network "container:$kong" --user 65532 --cap-drop ALL "$img" \
    curl -sk -m 3 -o /dev/null -w '%{http_code}' "$1" 2> /dev/null; }
  code=$(inside https://127.0.0.1:8443/)
  check F-1 "probe inside Kong reaches the proxy port 8443 (HTTP ${code:-none})" test "${code:-000}" != 000
  for i in http://127.0.0.1:8001/ https://127.0.0.1:8444/; do
    inside "$i" > /dev/null; code=$?
    check F-1 "nothing listens on admin $i inside Kong (curl exit $code, 7 is refused)" test "$code" -eq 7
  done

  # B-5 for Kong: the key is a mounted file, and Kong serves the certificate from ./secrets.
  check B-5 "Kong's certificate key is mounted at /run/secrets/kong-tls.key" \
    bash -c "docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' '$kong' | grep -qw /run/secrets/kong-tls.key"
  out=$(openssl s_client -connect "$addr" -servername localhost < /dev/null 2> /dev/null | openssl x509 -noout -fingerprint -sha256 2> /dev/null)
  check B-5 "Kong serves secrets/kong-tls.crt (${out:-no certificate})" \
    test -n "$out" -a "$out" = "$(openssl x509 -in "$repo/secrets/kong-tls.crt" -noout -fingerprint -sha256)"

  # K-1 (a), (c), (d): a request carrying everything a client must not pass on.
  out=$(curl -sk "$url/spike/k1" -H "Authorization: Bearer good-$run-d" -H 'Cookie: session=client' \
    -H 'x-chassis-internal-token: forged' -H 'x-chassis-correlation-id: forged' -H 'x-chassis-budget-ms: 99999' \
    -H 'X-Forwarded-User: mallory' -H 'X-Remote-User: mallory' -H 'X-Forwarded-For: 203.0.113.66')
  rec=$(stub_received | jq -c --arg a "Bearer good-$run-d" '[.[] | select(.body.authorization == $a)] | last')
  printf '%s\n%s\n' "$out" "${rec:-null}" > "$d/d.json"
  echo "        upstream saw: $(jq -c '.headers' <<< "$out" 2> /dev/null || echo "$out")"
  check K-1 "(a) the client's Authorization reached edge-auth through kong.ctx.shared" \
    jqt '.[1] != null' "$d/d.json"
  check K-1 "(c) edge-auth got exactly { authorization, route, method, path } ($(jq -c .body <<< "${rec:-null}"))" \
    jqt '.[1].body | (keys == ["authorization","method","path","route"]) and .route == "spike-k1"
      and .method == "GET" and .path == "/spike/k1"' "$d/d.json"
  check K-1 "(d) upstream got Bearer <x-chassis-internal-token>, the stub's correlation id and budget" \
    jqt '.[0].headers as $h | .[1].issued as $i
      | $h.authorization == "Bearer \($i["x-chassis-internal-token"])"
      and $h["x-chassis-correlation-id"] == $i["x-chassis-correlation-id"]
      and $h["x-chassis-budget-ms"] == $i["x-chassis-budget-ms"]' "$d/d.json"
  check K-1 "(a)(d) no Cookie, X-Forwarded-User, X-Remote-User or client x-chassis-* reached the upstream" \
    jqt '.[0].headers | (has("cookie") or has("x-forwarded-user") or has("x-remote-user")
      or .["x-chassis-internal-token"] == "forged" or .["x-chassis-correlation-id"] == "forged") | not' "$d/d.json"
  check K-1 "(d) X-Forwarded-For holds only the address Kong sees ($(jq -r '.headers | "\(.["x-forwarded-for"]) / X-Real-IP \(.["x-real-ip"])"' <<< "$out" 2> /dev/null))" \
    jqt '.[0].headers | .["x-forwarded-for"] == .["x-real-ip"] and (.["x-real-ip"] | length > 0)' "$d/d.json"

  # K-1 (d): a token edge-auth refuses gives the client its status and Problem body.
  code=$(curl -sk -o "$d/b" -w '%{http_code} %{content_type}' "$url/spike/k1" -H "Authorization: Bearer nope-$run")
  check K-1 "(d) refused token: client gets the stub's 401 Problem ($code)" \
    bash -c "[ '$code' = '401 application/problem+json' ] && jq -e '.status == 401' '$d/b' > /dev/null"
  # K-1 (c): the stub waits 3 s; Kong's 2 s timeout turns the failed call into 503.
  code=$(curl -sk -o /dev/null -w '%{http_code} %{time_total}' "$url/spike/k1" -H "Authorization: Bearer slow-$run")
  check K-1 "(c) edge-auth slower than 2 s gives 503 (status and seconds: $code)" \
    bash -c "set -- $code; [ \"\$1\" = 503 ] && awk -v t=\"\$2\" 'BEGIN { exit !(t >= 1.9 && t < 3) }'"

  # K-1 (e), and the forged-header part of (b) from the host: the limited route allows 3 a minute.
  echo "        waiting for a fresh rate-limit minute"
  fresh_minute
  ok=0 limited=0
  for i in 1 2 3 4 5 6; do
    code=$(curl -sk -o /dev/null -w '%{http_code}' "$url/spike/k1-limit" -H "Authorization: Bearer good-$run-e")
    case $code in 200) ok=$((ok + 1)) ;; 429) limited=$((limited + 1)) ;; esac
  done
  code=$(curl -sk -o /dev/null -w '%{http_code}' "$url/spike/k1-limit" -H "Authorization: Bearer good-$run-b" \
    -H 'X-Forwarded-For: 198.51.100.7')
  n=$(stub_received | jq --arg a "Bearer good-$run-e" '[.[] | select(.body.authorization == $a)] | length')
  check K-1 "(e) 3 a minute: $ok got 200 and edge-auth saw ${n:-?}; $limited got 429 and never reached it" \
    test "$ok" -eq 3 -a "$limited" -eq 3 -a "${n:--1}" -eq 3
  check K-1 "(b) from the host: a forged X-Forwarded-For stays in the same bucket (got $code)" test "$code" = 429
  notrun K-1 "(b) real LAN addresses and separate buckets: needs two off-host sources (k1 --from, spec open question 5)"
  rm -rf "$d"
}

# K-1 (b) from a device off the host. Prints the address Kong sees for this device, and checks
# that a forged X-Forwarded-For does not move it to a fresh bucket.
section_k1_from() {
  local label=$1 url="https://$2" mine=$3 seen code i limited=0
  seen=$(curl -sk "$url/spike/k1" -H "Authorization: Bearer good-from-$label" | jq -r '.headers["x-real-ip"] // empty')
  check K-1 "(b) $label: Kong sees ${seen:-nothing}, this device's LAN address is $mine" test "$seen" = "$mine"
  echo "        waiting for a fresh rate-limit minute"
  fresh_minute
  for i in 1 2 3 4 5; do
    code=$(curl -sk -o /dev/null -w '%{http_code}' "$url/spike/k1-limit" -H "Authorization: Bearer good-from-$label" \
      -H "X-Forwarded-For: 198.51.100.$i")
    [ "$code" = 429 ] && limited=$((limited + 1))
  done
  check K-1 "(b) $label: forged X-Forwarded-For values share one bucket ($limited of 5 got 429)" test "$limited" -gt 0
  notrun K-1 "(b) separate buckets: run this on a second device within the same minute; it should get 200s"
}

# Which target answers each of 20 requests through Kong's K-2 route, as
# "a=<n> b=<n> 5xx=<n> other=<n>"; other is anything else, such as a curl failure.
k2_count() {
  local i body a=0 b=0 bad=0 other=0
  for i in $(seq 20); do
    body=$(curl -sk -w ' %{http_code}' "$1/spike/k2")
    case $body in
      "target-a 200") a=$((a + 1)) ;;
      "target-b 200") b=$((b + 1)) ;;
      *" 5"??) bad=$((bad + 1)) ;;
      *) other=$((other + 1)) ;;
    esac
  done
  echo "a=$a b=$b 5xx=$bad other=$other"
}
k2_flip() {
  dc run --rm --no-deps -T probe curl -sf -X POST "http://$1:8080/_spike/$2" > /dev/null 2>&1 ||
    fail K-2 "could not flip $1 $2"
}
# Both targets answer, nothing failed.
k2_both='^a=[1-9][0-9]*\ b=[1-9][0-9]*\ 5xx=0\ other=0$'

section_k2() {
  local d addr url seen i
  d=$(mktemp -d)
  if ! (cd "$repo" && scripts/up) > "$d/up.log" 2>&1 || ! dc up -d --wait target-a target-b > "$d/t.log" 2>&1; then
    fail K-2 "stack did not start: $(tail -3 "$d/up.log" "$d/t.log" | tr '\n' ' ')"
    rm -rf "$d"; return
  fi
  rm -rf "$d"
  addr=$(dc port kong 8443 | grep -v '^\[' | head -1)
  url="https://${addr/0.0.0.0/127.0.0.1}"
  k2_flip target-a ready/1; k2_flip target-a fail/0; k2_flip target-b ready/1; k2_flip target-b fail/0
  # Kong may have started before the targets existed; give its DNS and checks up to 60 s.
  for i in $(seq 30); do
    seen=$(k2_count "$url")
    [[ $seen =~ $k2_both ]] && break
    sleep 2
  done
  check K-2 "both targets serve at the start ($seen)" bash -c "[[ '$seen' =~ $k2_both ]]"

  # Active: target-a fails /readyz, so Kong takes it out; it comes back once /readyz passes.
  k2_flip target-a ready/0; sleep 4
  seen=$(k2_count "$url")
  check K-2 "active: target-a failing /readyz gets no traffic ($seen)" test "$seen" = "a=0 b=20 5xx=0 other=0"
  k2_flip target-a ready/1; sleep 8
  seen=$(k2_count "$url")
  check K-2 "active: target-a back after /readyz passes ($seen)" bash -c "[[ '$seen' =~ $k2_both ]]"

  # Passive: target-a answers 500 while /readyz still passes; Kong takes it out after 2. An active
  # probe on the 5 s cadence can bring it back once mid-burst, hence up to 6.
  k2_flip target-a fail/1
  seen=$(k2_count "$url")
  check K-2 "passive: target-a answering 500 leaves rotation after a few ($seen)" \
    bash -c "[[ '$seen' =~ ^a=0\ b=[0-9]+\ 5xx=([0-9]+)\ other=0$ ]] && [ \"\${BASH_REMATCH[1]}\" -ge 1 ] && [ \"\${BASH_REMATCH[1]}\" -le 6 ]"
  k2_flip target-a fail/0; sleep 8
  seen=$(k2_count "$url")
  check K-2 "passive: target-a back once it answers again ($seen)" bash -c "[[ '$seen' =~ $k2_both ]]"
}

# K-3 helpers. Kafka commands run inside the kafka container as admin; Connect's REST API is
# reached from inside connect, which is the only place it can be (§4.12).
kafka_sh() { local t=$1; shift; dc exec -T kafka "/opt/kafka/bin/$t" --bootstrap-server localhost:9092 "$@"; }
connect_api() { dc exec -T connect curl -s -X "$1" -H 'Content-Type: application/json' "http://localhost:8083$2" "${@:3}"; }
connector_state() { connect_api GET /connectors/spike/status | jq -r '[.connector.state, (.tasks[]?.state)] | join(" ")' 2> /dev/null; }
wait_state() { local i; for i in $(seq 60); do [ "$(connector_state)" = "$1" ] && return 0; sleep 2; done; return 1; }
# -q drops command tags such as "INSERT 0 1"; PGOPTIONS drops NOTICEs.
psql_spike() { dc exec -T -u postgres -e PGOPTIONS='-c client_min_messages=warning' postgres \
  psql -X -q -At -v ON_ERROR_STOP=1 -d spike -c "$1"; }
end_offset() { kafka_sh kafka-get-offsets.sh --command-config /tmp/kafka/admin.properties --topic "$1" --time -1 2> /dev/null |
  awk -F: '$3 ~ /^[0-9]+$/ { s += $3; n++ } END { if (n) print s }'; }
# The console consumer's option names, which Kafka 4 renamed; set once per run by k3_flags.
k3_cc=--consumer.config k3_fp=--property
k3_flags() {
  local help
  help=$(kafka_sh kafka-console-consumer.sh --help 2>&1)
  grep -q -- --command-config <<< "$help" && k3_cc=--command-config
  grep -q -- --formatter-property <<< "$help" && k3_fp=--formatter-property
}
# Every record on ev.spike.example as one JSON line: {h: [{key, value}], key, value}.
# The host's Kafka printed headers with the default separators ("," and ":") despite the
# separator properties, so the parser takes either: "|" between headers if any is present, else
# ","; and per header the first of "=" or ":" (header names here contain neither).
k3_records() {
  kafka_sh kafka-console-consumer.sh "$k3_cc" /tmp/kafka/admin.properties --topic ev.spike.example \
    --from-beginning --timeout-ms 8000 "$k3_fp" print.key=true "$k3_fp" print.headers=true \
    "$k3_fp" headers.separator='|' "$k3_fp" headers.key.separator='=' 2> /dev/null |
    jq -Rc 'split("\t") | { h: (.[0] | split(if test("[|]") then "|" else "," end)
        | map(([index("="), index(":")] | map(select(. != null)) | min) as $i | { key: .[:$i], value: .[$i + 1:] })),
      key: .[1], value: (.[2:] | join("\t") | fromjson? // .) }'
}
# Waits until ev.spike.example holds at least $2 records with key $1; leaves them in $3.
k3_wait() { local i; for i in $(seq 8); do k3_records | jq -c --arg k "$1" 'select(.key == $k)' > "$3"
  [ "$(wc -l < "$3")" -ge "$2" ] && return 0; done; return 1; }
# Inserts one outbox row with every column set, with seq $4 if given. Prints the row as JSON.
k3_insert() {
  local sc="" sv="" ov=""
  [ -n "${4:-}" ] && { sc="seq, "; sv="$4, "; ov="overriding system value"; }
  psql_spike "insert into chassis_outbox (${sc}id, kind, topic, aggregatetype, aggregateid, type, payload, ce_subject,
      ce_dataschema, ce_tenantid, ce_aggregateversion, ce_correlationid, ce_causationid, ce_traceparent,
      ce_authtype, ce_authid, ce_authclaims) $ov
    values (${sv}gen_random_uuid(), 'event', '$1', 'example', '$2', 'spike.example.created.v1',
      '{\"run\": \"$2\", \"n\": $3}', 'examples/$2', 'https://schemas.setpiece.invalid/spike/example/v1.json',
      'tenant-spike', $3, 'corr-$2', 'cause-$2', '00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01',
      'user', 'sub-spike', '{\"client_id\": \"spike-client\"}')
    returning row_to_json(chassis_outbox)"
}
# Adds or removes connect-producer's write on the heartbeat topic ($@: --add, or --remove --force).
k3_hb_acl() { dc exec -T kafka /opt/kafka/bin/kafka-acls.sh --bootstrap-server localhost:9092 \
  --command-config /tmp/kafka/admin.properties "$@" --allow-principal User:connect-producer \
  --operation Write --operation Describe --topic __debezium-heartbeat.cdc.spike > /dev/null 2>&1; }
# Writes a K-3 password file into ./secrets if it is missing, under B-2's rules.
spike_secret() {
  local f="$repo/secrets/$1" v
  [ -e "$f" ] && return
  v=$( (LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom || true) | head -c 32)
  (umask 077 && printf '%s' "$v" > "$f.tmp" && chmod 0444 "$f.tmp" && mv "$f.tmp" "$f")
}

# K-3 runs in k3_run; k3_cleanup always follows it, whichever way k3_run returned.
section_k3() {
  local d run
  d=$(mktemp -d)
  run="k3-$(date +%s)"
  k3_run
  k3_cleanup
  rm -rf "$d"
}
k3_run() {
  local row id out a b lsn1 lsn2 i ids order
  # The base stack, then the fixture: secrets, hba lines, the database, connect with its secret.
  if ! (cd "$repo" && scripts/up) > "$d/up.log" 2>&1; then
    fail K-3 "scripts/up failed: $(tail -3 "$d/up.log" | tr '\n' ' ')"; return
  fi
  k3_flags
  spike_secret spike_owner; spike_secret spike_cdc
  cp "$repo/spike/hba-spike.conf" "$repo/pg/hba.d/spike.conf"
  psql_su "select pg_reload_conf()" > /dev/null
  if ! dc run --rm --no-deps -T spike-init > "$d/init.log" 2>&1 || ! dc up -d --no-deps connect > "$d/c.log" 2>&1; then
    fail K-3 "fixture did not start: $(tail -3 "$d/init.log" "$d/c.log" | tr '\n' ' ')"; return
  fi
  for i in $(seq 60); do connect_api GET /connectors > /dev/null 2>&1 && break; sleep 3; done
  # §4.2 erratum (E03 D-014): Debezium's heartbeat record is produced, so its offset commits and the slot
  # moves. Its topic and connect-producer's write ACL stand in for what kafka-init would generate.
  kafka_sh kafka-topics.sh --command-config /tmp/kafka/admin.properties --create --if-not-exists \
    --topic __debezium-heartbeat.cdc.spike --partitions 1 --replication-factor 1 > /dev/null 2>&1
  k3_hb_acl --add
  connect_api PUT /connectors/spike/config --data-binary @- < "$repo/spike/connect-spike.json" > "$d/put.json"
  check K-3 "connector spike and its task RUNNING (heartbeat lowered to 10 s for the test)" wait_state "RUNNING RUNNING"
  kafka_sh kafka-topics.sh --command-config /tmp/kafka/admin.properties --create --if-not-exists \
    --topic ev.other.example --partitions 1 --replication-factor 1 > /dev/null 2>&1
  check K-3b "topic ev.other.example exists" \
    kafka_sh kafka-topics.sh --command-config /tmp/kafka/admin.properties --describe --topic ev.other.example

  # K-3 (a), (b), (c): one row with every column, read back as admin.
  row=$(k3_insert ev.spike.example "$run-a" 1)
  if ! k3_wait "$run-a" 1 "$d/a.json"; then
    fail K-3 "no record with key $run-a reached ev.spike.example (connector: $(connector_state))"
  fi
  out=$(head -1 "$d/a.json")
  echo "        row:     $row"
  echo "        headers: $(jq -c '[.h[] | "\(.key)=\(.value)"]' <<< "${out:-null}")"
  printf '%s\n%s\n' "${out:-null}" "$row" > "$d/a2.json"
  check K-3 "(a) key is the plain string aggregateid ($(jq -r .key <<< "${out:-null}"))" jqt '.[0].key == .[1].aggregateid' "$d/a2.json"
  check K-3 "(b) value is the plain JSON payload, no schema envelope ($(jq -c .value <<< "${out:-null}"))" \
    jqt '.[0].value == .[1].payload' "$d/a2.json"
  check K-3 "(c) text headers equal their columns (ce_id from id, ce_type from type)" \
    jqt '(.[0].h | map({(.key): .value}) | add) as $h | .[1] as $r
      | $h.ce_id == $r.id and $h.ce_type == $r.type and ([ "ce_subject", "ce_dataschema", "ce_tenantid",
        "ce_correlationid", "ce_causationid", "ce_traceparent", "ce_authtype", "ce_authid", "ce_authclaims" ]
        | all(. as $c | $h[$c] == $r[$c]))' "$d/a2.json"
  check K-3 "(c) ce_aggregateversion equal as a number ($(jq -r '.h[] | select(.key == "ce_aggregateversion") | .value' <<< "${out:-null}"))" \
    jqt '(.[0].h | map({(.key): .value}) | add) as $h | ($h.ce_aggregateversion | tonumber?) == .[1].ce_aggregateversion' "$d/a2.json"
  a=$(jq -r '.h[] | select(.key == "ce_time") | .value' <<< "${out:-null}")
  id=$(jq -r .id <<< "$row")
  check K-3 "(c) ce_time equal as an instant (header $a, column $(jq -r .ce_time <<< "$row"))" \
    time_eq "$a" "$id"
  check K-3 "(c) ce_specversion 1.0, content-type application/json, exactly one ce_source = spike" \
    jqt '.[0].h as $h | ([$h[] | select(.key == "ce_source")] | map(.value)) == ["spike"]
      and ([$h[] | select(.key == "ce_specversion") | .value] == ["1.0"])
      and ([$h[] | select(.key == "content-type") | .value] == ["application/json"])' "$d/a2.json"

  # K-3b: rows naming another service's topic, or a Connect topic, go nowhere.
  a=$(end_offset ev.other.example); b=$(end_offset connect-configs)
  k3_insert ev.other.example "$run-b1" 1 > /dev/null
  k3_insert connect-configs "$run-b2" 1 > /dev/null
  k3_insert ev.spike.example "$run-b3" 1 > /dev/null
  k3_wait "$run-b3" 1 "$d/b.json"
  # Taken once the spike rows are delivered: no spike change but the heartbeat's comes after it.
  lsn1=$(psql_su "select pg_current_wal_lsn()")
  check K-3b "the next valid row still arrives" test -s "$d/b.json"
  check K-3b "connector and task still RUNNING after the foreign rows" wait_state "RUNNING RUNNING"
  # end_offset prints nothing when the read fails, so an empty value fails these checks.
  check K-3b "ev.other.example end offset unchanged ($a -> $(end_offset ev.other.example))" \
    test -n "$a" -a "$a" = "$(end_offset ev.other.example)"
  check K-3b "connect-configs end offset unchanged and readable ($b -> $(end_offset connect-configs))" \
    test -n "$b" -a "${b:-0}" -gt 0 -a "$b" = "$(end_offset connect-configs)"
  check K-3b "no record for the foreign rows on ev.spike.example" \
    no_record "$run-b1" "$run-b2"

  # K-3c: spike is quiet while the postgres database writes WAL; the heartbeat moves the slot.
  # lsn1 is past every spike row's commit, so the slot can pass it only by the heartbeat.
  # The slot moves when Connect flushes offsets (every 60 s by default), so allow up to 120 s.
  # Each sample: slot position, the heartbeat row's time, and the LSN Connect has stored.
  for i in $(seq 36); do
    psql_su "set client_min_messages = warning; create table if not exists spike_wal (x int);
      insert into spike_wal select generate_series(1, 20000); truncate spike_wal" > /dev/null
    sleep 5
    lsn2=$(psql_su "select confirmed_flush_lsn from pg_replication_slots where slot_name = 'cdc_spike'")
    [ $((i % 3)) -eq 0 ] && echo "        K-3c $((i * 5))s: slot $lsn2, heartbeat $(psql_spike "select at from chassis_heartbeat" 2> /dev/null), connect offset $(connect_api GET /connectors/spike/offsets 2> /dev/null | jq -c '[.offsets[]?.offset]' 2> /dev/null)"
    [ "$i" -ge 5 ] && lsn_after "$lsn1" "$lsn2" && break
  done
  psql_su "drop table if exists spike_wal" > /dev/null
  lsn_after "$lsn1" "$lsn2" || dc logs --since 5m connect 2>&1 | grep -iE 'warn|error|heartbeat|flush|lsn' | tail -25 | sed 's/^/        connect: /'
  echo "        K-3c heartbeat topic end offset: $(end_offset __debezium-heartbeat.cdc.spike)"
  check K-3c "confirmed_flush_lsn of cdc_spike passed the WAL position after the last spike row within $((i * 5)) s, heartbeat 10 s ($lsn1 -> $lsn2)" \
    lsn_after "$lsn1" "$lsn2"

  # K-3d: three rows on one key, then stop, delete the offsets and resume (§4.2 recovery 1, 3, 4).
  # Three seq values are taken first and the rows inserted as 3, 1, 2, so the heap is out of seq
  # order and a snapshot without the `order by seq` override would not publish them in order.
  local sq s1 id1 id2 id3
  sq=$(psql_spike "select pg_get_serial_sequence('chassis_outbox', 'seq')")
  s1=$(psql_spike "select min(v) from (select nextval('$sq') as v from generate_series(1, 3)) t")
  id3=$(k3_insert ev.spike.example "$run-d" 3 $((s1 + 2)) | jq -r .id)
  id1=$(k3_insert ev.spike.example "$run-d" 1 "$s1" | jq -r .id)
  id2=$(k3_insert ev.spike.example "$run-d" 2 $((s1 + 1)) | jq -r .id)
  ids="$id1 $id2 $id3 "
  k3_wait "$run-d" 3 "$d/d1.json"
  order=$(psql_spike "select array_agg(seq order by ctid) = array_agg(seq order by seq) from chassis_outbox where aggregateid = '$run-d'")
  check K-3d "precondition: the key's rows are out of seq order in the heap" test "$order" = f
  connect_api PUT /connectors/spike/stop > /dev/null
  check K-3d "connector stopped" wait_state STOPPED
  connect_api DELETE /connectors/spike/offsets > "$d/off.json"
  connect_api PUT /connectors/spike/resume > /dev/null
  wait_state "RUNNING RUNNING"
  k3_wait "$run-d" 6 "$d/d2.json"
  out=$(tail -3 "$d/d2.json" | jq -r '.h[] | select(.key == "ce_id") | .value' | tr '\n' ' ')
  echo "        offsets delete: $(cat "$d/off.json")"
  check K-3d "re-snapshot published the key's rows again in seq order (inserted: $ids; again: $out)" \
    test "$(wc -l < "$d/d2.json")" -ge 6 -a "$out" = "$ids"

}
# No connector, offsets or slot left behind, and connect back to its base config. Safe to run
# after any early return of k3_run.
k3_cleanup() {
  local i
  if connect_api GET /connectors/spike > /dev/null 2>&1; then
    connect_api PUT /connectors/spike/stop > /dev/null; wait_state STOPPED
    connect_api DELETE /connectors/spike/offsets > /dev/null
    connect_api DELETE /connectors/spike > /dev/null
  fi
  for i in $(seq 10); do
    psql_su "select pg_terminate_backend(active_pid) from pg_replication_slots where slot_name = 'cdc_spike' and active_pid is not null" > /dev/null 2>&1
    psql_su "select pg_drop_replication_slot('cdc_spike') from pg_replication_slots where slot_name = 'cdc_spike'" > /dev/null 2>&1
    [ -z "$(psql_su "select 1 from pg_replication_slots where slot_name = 'cdc_spike'")" ] && break
    sleep 2
  done
  k3_hb_acl --remove --force
  kafka_sh kafka-topics.sh --command-config /tmp/kafka/admin.properties --delete --if-exists \
    --topic __debezium-heartbeat.cdc.spike > /dev/null 2>&1
  rm -f "$repo/pg/hba.d/spike.conf"; psql_su "select pg_reload_conf()" > /dev/null
  (cd "$repo" && scripts/up) > "$d/up2.log" 2>&1
  check K-3 "cleanup: no connector spike ($(connect_api GET /connectors 2> /dev/null))" \
    test "$(connect_api GET /connectors 2> /dev/null | jq -c 'index("spike")')" = null
  check K-3 "cleanup: connect-producer's heartbeat ACL removed" \
    test -z "$(dc exec -T kafka /opt/kafka/bin/kafka-acls.sh --bootstrap-server localhost:9092 \
      --command-config /tmp/kafka/admin.properties --list --topic __debezium-heartbeat.cdc.spike 2> /dev/null | grep connect-producer)"
  check K-3 "cleanup: no replication slot cdc_spike" \
    test -z "$(psql_su "select 1 from pg_replication_slots where slot_name = 'cdc_spike'")"
  check K-3 "a base-only scripts/up afterwards brings connect back without the fixture secret" \
    connect_base
}
# True when the header text $1, read as an instant, equals ce_time of outbox row $2.
time_eq() { [ "$(psql_spike "select '$1'::timestamptz = ce_time from chassis_outbox where id = '$2'" 2> /dev/null)" = t ]; }
# True when no record on ev.spike.example has key $1 or $2.
# The topic is never empty here, so an empty read is a failed read, not "no record".
no_record() { local r; r=$(k3_records); [ -n "$r" ] && ! jq -e --arg a "$1" --arg b "$2" 'select(.key == $a or .key == $b)' <<< "$r" > /dev/null; }
# True when LSN $2 is after LSN $1.
lsn_after() { [ -n "$1" ] && [ -n "$2" ] && [ "$(psql_su "select '$2'::pg_lsn > '$1'::pg_lsn")" = t ]; }
# True when connect is healthy and no longer mounts the fixture's secret.
connect_base() {
  local c
  c=$(dc ps -q connect)
  [ "$(docker inspect -f '{{.State.Health.Status}}' "$c")" = healthy ] &&
    ! docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$c" | grep -q spike_cdc
}

[ $# -gt 0 ] || { sed -n '2,7p' "$0"; exit 2; }

psql_su() { dc exec -T -u postgres postgres psql -X -At -v ON_ERROR_STOP=1 -d postgres -c "$1"; }
cid() { dc ps -a -q "$1"; }
# Databases with owner and ACL, and roles with login and memberships: what a repeat must not change.
pg_objects() {
  psql_su "select 'db ' || datname || ' ' || pg_get_userbyid(datdba) || ' ' || coalesce(datacl::text, '')
           from pg_database order by datname"
  psql_su "select 'role ' || r.rolname || ' ' || r.rolcanlogin || ' ' || coalesce((select string_agg(b.rolname, ','
             order by b.rolname) from pg_auth_members m join pg_roles b on b.oid = m.roleid where m.member = r.oid), '')
           from pg_roles r where r.rolname !~ '^pg_' order by r.rolname"
}

section_pg() {
  local s v db before after rc rules last mounts cfg
  # C-1: the slot settings, as fixed constants.
  for s in wal_level=logical max_replication_slots=16 max_wal_senders=16 max_slot_wal_keep_size=10GB; do
    v=$(psql_su "show ${s%%=*}")
    check C-1 "${s%%=*} = $v" test "$v" = "${s#*=}"
  done

  # C-2: databases, roles, pg_monitor, CONNECT revoked from PUBLIC, and a repeat changes nothing.
  check C-2 "pg-init exited 0 on this bring-up" \
    test "$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}}' "$(cid pg-init)")" = "exited 0"
  for db in keycloak openfga monitor; do
    v=$(psql_su "select pg_get_userbyid(datdba) from pg_database where datname = '$db'")
    check C-2 "database $db exists, owned by '$v'" test "$v" = "$db"
  done
  v=$(psql_su "select pg_has_role('monitor', 'pg_monitor', 'member')")
  check C-2 "monitor is in pg_monitor ($v)" test "$v" = t
  for db in postgres keycloak openfga; do
    v=$(psql_su "select has_database_privilege('public', '$db', 'connect')")
    check C-2 "PUBLIC cannot connect to $db ($v)" test "$v" = f
  done
  # Each role signs in to its own database with the password from its secret file, and not to another.
  # shellcheck disable=SC2016 # expanded inside the container
  v=$(dc run --rm --no-deps -T --entrypoint sh pg-init -c '
    umask 077
    for r in keycloak openfga monitor; do
      printf "postgres:5432:*:%s:%s\n" "$r" "$(cat /run/secrets/$r-db)" > /tmp/pgpass
      PGPASSFILE=/tmp/pgpass psql -X -At -h postgres -U "$r" -d "$r" -c "select current_user" 2>&1
    done
    printf "postgres:5432:*:keycloak:%s\n" "$(cat /run/secrets/keycloak-db)" > /tmp/pgpass
    PGPASSFILE=/tmp/pgpass psql -X -At -h postgres -U keycloak -d openfga -c "select 1" > /dev/null 2>&1 &&
      echo keycloak-reached-openfga || echo keycloak-refused-openfga' 2> /dev/null)
  echo "        $(tr '\n' ' ' <<< "$v")"
  check C-2 "keycloak, openfga and monitor sign in with their secret-file passwords" \
    test "$(head -3 <<< "$v" | tr '\n' ' ')" = "keycloak openfga monitor "
  check C-3 "keycloak cannot sign in to the openfga database" grep -qx keycloak-refused-openfga <<< "$v"

  before=$(pg_objects)
  dc run --rm --no-deps -T pg-init 2>&1 | grep -v ' Container ' | sed 's/^/        /'
  rc=${PIPESTATUS[0]}
  after=$(pg_objects)
  check C-2 "a second pg-init exits 0 ($rc)" test "$rc" -eq 0
  check C-2 "a second pg-init changes no database or role" test "$before" = "$after"
  cfg=$(dc config --format json)
  v=$(jq -r '.services["openfga-migrate"].depends_on["pg-init"].condition // "none"' <<< "$cfg")
  check C-2 "openfga-migrate depends on pg-init ($v)" test "$v" = service_completed_successfully
  if jq -e '.services.keycloak' <<< "$cfg" > /dev/null; then
    v=$(jq -r '.services.keycloak.depends_on["pg-init"].condition // "none"' <<< "$cfg")
    check C-2 "keycloak depends on pg-init ($v)" test "$v" = service_completed_successfully
  else
    notrun C-2 "keycloak depends on pg-init: no keycloak yet (OUT-151)"
  fi

  # C-3: the allowlist as the server loaded it, include_dir last, and hba.d mounted as a directory.
  check C-3 "hba_file is the mounted base file" test "$(psql_su 'show hba_file')" = /etc/postgresql/pg_hba.conf
  rules=$(psql_su "select type || ' ' || array_to_string(database, ',') || ' ' || array_to_string(user_name, ',')
                   || ' ' || coalesce(address, '-') || ' ' || auth_method from pg_hba_file_rules
                   where error is null order by rule_number")
  printf '%s\n' "$rules" | sed 's/^/        /'
  check C-3 "no pg_hba error" test "$(psql_su 'select count(*) from pg_hba_file_rules where error is not null')" = 0
  for s in "host all postgres samenet scram-sha-256" "host keycloak keycloak samenet scram-sha-256" \
    "host openfga openfga samenet scram-sha-256" "host monitor monitor samenet scram-sha-256"; do
    check C-3 "rule: $s" grep -qxF "$s" <<< "$rules"
  done
  check C-3 "no replication rule for all users" bash -c "! grep -Eq '^host[a-z]* ([^ ]*,)?replication(,[^ ]*)? ([^ ]*,)?all(,| )' <<< '$rules'"
  last=$(grep -Ev '^[[:space:]]*(#|$)' "$repo/pg/pg_hba.conf" | tail -1)
  check C-3 "last line of pg/pg_hba.conf is include_dir hba.d ($last)" test "$last" = "include_dir hba.d"
  mounts=$(docker inspect -f '{{json .Mounts}}' "$(cid postgres)")
  check C-3 "pg/hba.d is bind-mounted as a directory at /etc/postgresql/hba.d" bash -c \
    "jq -e --arg src '$repo/pg/hba.d' 'any(.[]; .Type == \"bind\" and .Source == \$src and .Destination == \"/etc/postgresql/hba.d\")' <<< '$mounts' > /dev/null &&
     docker exec '$(cid postgres)' test -d /etc/postgresql/hba.d"

  # C-4: OpenFGA on its own database, after its migration. B-5: it reads its secrets from the file.
  v=$(jq -r '.services.openfga.depends_on["openfga-migrate"].condition // "none"' <<< "$cfg")
  check C-4 "openfga depends on openfga-migrate ($v)" test "$v" = service_completed_successfully
  check C-4 "openfga-migrate exited 0" \
    test "$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}}' "$(cid openfga-migrate)")" = "exited 0"
  v=$(docker inspect -f '{{.State.Health.Status}}' "$(cid openfga)")
  check C-4 "openfga is $v" test "$v" = healthy
  v=$(dc exec -T -u postgres postgres psql -X -At -d openfga -c "select count(*) from goose_db_version" 2>&1)
  check C-4 "OpenFGA's schema is in the openfga database (goose_db_version rows: $v)" test "${v:-0}" -gt 0 2> /dev/null
  # shellcheck disable=SC2016 # expanded inside the probe
  v=$(docker compose -f "$repo/compose.base.yaml" -f "$repo/spike/compose.spike.yaml" run --rm --no-deps -T \
    -v "$repo/secrets/openfga-preshared-key:/run/k:ro" --entrypoint sh probe -c '
      curl -s -o /dev/null -w "%{http_code} " http://openfga:8080/stores
      curl -s -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $(cat /run/k)" http://openfga:8080/stores' 2> /dev/null)
  check B-5 "OpenFGA refuses no key and accepts the preshared key from its config file ($v)" test "$v" = "401 200"
}

# Telemetry (spec I-1 to I-4).
cid_of() { dc ps -q "$1" 2> /dev/null | head -1; }
lgtm() { dc exec -T otel-lgtm "$@"; }
# Lines in Loki (inside otel-lgtm) holding $1, over the last hour.
loki_count() {
  lgtm curl -sG localhost:3100/loki/api/v1/query_range \
    --data-urlencode "query={service_name=~\".+\"} |= \"$1\"" --data-urlencode since=1h |
    jq '[.data.result[]?.values[]?] | length' 2> /dev/null || echo 0
}
# Waits up to $2 seconds for $1 to appear in Loki; prints the seconds it took, or fails.
wait_loki() {
  local t0=$SECONDS n
  while [ $((SECONDS - t0)) -le "$2" ]; do
    n=$(loki_count "$1")
    [ "${n:-0}" -gt 0 ] 2> /dev/null && { echo $((SECONDS - t0)); return 0; }
    sleep 5
  done
  return 1
}

# K-5: @platformatic/kafka on Node 26, as svc-spike, reads the newest K-3 record with its key and
# every header, and is refused when it produces. Needs a record from k3 on ev.spike.example.
section_k5() {
  local ref key ceid runid out got prod err
  if ! (cd "$repo" && scripts/up) > /dev/null 2>&1; then fail K-5 "scripts/up failed"; return; fi
  k3_flags
  ref=$(k3_records | jq -sc '[.[] | select(any(.h[]; .key == "ce_id"))] | last // empty')
  if [ -z "$ref" ]; then fail K-5 "no K-3 record on ev.spike.example (run k3 first)"; return; fi
  key=$(jq -r .key <<< "$ref")
  ceid=$(jq -r '.h[] | select(.key == "ce_id") | .value' <<< "$ref")
  runid=$(jq -r '.h[] | select(.key == "__debezium.context.runId") | .value' <<< "$ref")
  err=$(mktemp)
  out=$(dc --profile k5 run --rm --no-deps -T k5 "$key" "$ceid" "$runid" 2> "$err")
  got=$(grep -m1 '"found"' <<< "$out")
  prod=$(grep -m1 '"produced"' <<< "$out")
  echo "        read:    ${got:-<nothing>}"
  echo "        produce: ${prod:-<nothing>}"
  [ -n "$got" ] && [ -n "$prod" ] || sed 's/^/        k5 stderr: /' "$err" | tail -15
  rm -f "$err"
  check K-5 "svc-spike read the record with key $key, ce_id $ceid, connector run $runid" jqin '.found == true and .key == $k and .headers.ce_id == $i' --arg k "$key" --arg i "$ceid" <<< "${got:-null}"
  check K-5 "the value is the record's plain JSON body" \
    jqin --argjson r "$ref" '(.value | fromjson) == $r.value' <<< "${got:-null}"
  check K-5 "every header the admin consumer sees is there with the same value" \
    jqin --argjson r "$ref" '.headers as $h | $r.h | all(.value == $h[.key])' <<< "${got:-null}"
  check K-5 "the Produce request as svc-spike is refused with TOPIC_AUTHORIZATION_FAILED, not a network or sign-in error" \
    jqin '.produced == false and (.errors | any(test("Produce\\(v"))) and (.errors | any(test("\\[TOPIC_AUTHORIZATION_FAILED\\]"))) and (.errors | any(test("AUTHENTICATION|NETWORK")) | not)' <<< "${prod:-null}"
  check K-5 "no record with the produce's key reached ev.spike.example" no_record k5-should-not-land k5-should-not-land
}

# Base containers of the project, running or exited, as "service<TAB>container id" lines.
base_containers() {
  local svc
  for svc in $(base_services); do
    dc ps -a -q "$svc" | sed "s/^/$svc\t/"
  done
}
base_services() { docker compose -f "$repo/compose.base.yaml" --profile "*" config --services; }
# The base services with no container in the project (one name per line); $1 is base_containers.
missing_containers() { base_services | grep -vxF -f <(cut -f1 <<< "$1"); }
# The entries of an expected-value file: comments and all whitespace dropped, as scripts/up does.
expected() { sed -E 's/#.*//; s/[[:space:]]+/ /g; s/^ //; s/ $//; /^$/d' "$1"; }

# Checks on the running stack (plan issue 10): A-4, A-7, A-8, K-6d, B-6 and B-5's non-root read.
section_static() {
  local want have bad c svc v f n img rows miss vols
  if ! (cd "$repo" && scripts/up) > /dev/null 2>&1; then
    fail A-4 "scripts/up failed"
    for v in A-7 A-8 K-6d B-6 B-5; do notrun "$v" "scripts/up failed"; done
    return
  fi
  rows=$(base_containers)
  miss=$(missing_containers "$rows" | tr '\n' ' ')
  # A-4: services.txt is the base file's services minus its one-shots.
  want=$(base_services | grep -vxF -f <(expected "$repo/spike/expected/one-shots.txt") | sort)
  have=$(expected "$repo/platform/services.txt" | sort)
  check A-4 "platform/services.txt equals the base services minus one-shots (diff: $(diff <(echo "$want") <(echo "$have") | grep '^[<>]' | tr '\n' ' '))" \
    test -n "$have" -a "$want" = "$have"
  # A-7, A-8: each long-running container restarts unless stopped, has a health check and is healthy.
  bad=""
  for svc in $have; do
    c=$(dc ps -q "$svc" | head -1)
    if [ -z "$c" ]; then bad+=" $svc:not-running"; continue; fi
    [ "$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$c")" = unless-stopped ] || bad+=" $svc:restart"
  done
  check A-7 "every long-running container has restart unless-stopped (offenders:${bad:- none})" test -n "$have" -a -z "$bad"
  bad=""
  for svc in $have; do
    c=$(dc ps -q "$svc" | head -1)
    [ -n "$c" ] || { bad+=" $svc:not-running"; continue; }
    v=$(docker inspect -f '{{if .Config.Healthcheck}}{{.State.Health.Status}}{{else}}none{{end}}' "$c")
    [ "$v" = healthy ] || bad+=" $svc:$v"
  done
  check A-8 "every long-running container has a health check and is healthy (offenders:${bad:- none})" test -n "$have" -a -z "$bad"
  # K-6d: every image of the base containers, as configured and as running, is pinned by digest.
  bad=$(docker compose -f "$repo/compose.base.yaml" --profile "*" config --images | grep -v '@sha256:[0-9a-f]\{64\}$' | tr '\n' ' ')
  while IFS=$'\t' read -r svc c; do
    img=$(docker inspect -f '{{.Config.Image}}' "$c")
    [[ $img =~ @sha256:[0-9a-f]{64}$ ]] || bad+=" $svc:$img"
  done <<< "$rows"
  check K-6d "every base image is pinned by digest, in config and in every base container (offenders: ${bad:-none}; no container: ${miss:-none})" \
    test -z "${bad// /}" -a -z "${miss// /}"
  # B-6: no secret file's value in any base container's Env, Cmd, Entrypoint or Healthcheck,
  # running or exited, one-shots included. grep reads the values from the files (-f), so they
  # never reach a command line.
  bad="" n=0
  while IFS=$'\t' read -r svc c; do
    [ -n "$c" ] || continue
    n=$((n + 1))
    v=$(docker inspect -f '{{json .Config.Env}}{{json .Config.Cmd}}{{json .Config.Entrypoint}}{{json .Config.Healthcheck}}' "$c")
    for f in "$repo"/secrets/*; do
      [ -s "$f" ] || continue
      grep -qFf "$f" <<< "$v" && bad+=" $svc:${f##*/}"
    done
  done <<< "$rows"
  check B-6 "no secret value in Env, Cmd, Entrypoint or Healthcheck of $n base containers (leaks:${bad:- none}; no container: ${miss:-none})" \
    test -z "$bad" -a "$n" -gt 0 -a -z "${miss// /}"
  # B-5: a non-root container (uid 65532, the stand-in's image) reads every secret file, each
  # mounted on its own under /run/secrets the way Compose mounts secrets.
  n=0 vols=()
  for f in "$repo"/secrets/*; do [ -f "$f" ] && { n=$((n + 1)); vols+=(-v "$f:/run/secrets/${f##*/}:ro"); }; done
  img=$(dc config --format json | jq -r '.services["stand-in"].image')
  out=$(docker run --rm --user 65532:65532 --read-only --cap-drop ALL --network none "${vols[@]}" "$img" \
    sh -c 'n=0; for f in /run/secrets/*; do [ -f "$f" ] || continue; n=$((n+1)); cat "$f" > /dev/null || echo "unreadable ${f##*/}"; done; echo "files $n"' 2>&1)
  check B-5 "uid 65532 reads every one of the $n secret files mounted ($(tr '\n' ' ' <<< "$out"))" \
    bash -c '[ "$2" -gt 0 ] && grep -qx "files $2" <<< "$1" && ! grep -q unreadable <<< "$1"' _ "$out" "$n"
}

# J-1: each base container's networks against spike/expected/networks.txt, before the overlay is
# applied; every member of each network is an expected base container; idp and data are internal.
section_net() {
  local svc nets got want bad net name internal want_int c rows cfg
  if ! (cd "$repo" && scripts/up) > /dev/null 2>&1; then
    fail J-1 "scripts/up failed"; return
  fi
  rows=$(base_containers)
  cfg=$(dc config --format json)
  # Each actual network name back to its key (edge, idp, ...), exactly; another project's
  # network has no key and shows as itself.
  netkey() { jq -r --arg n "$1" '.networks | to_entries[] | select(.value.name == $n) | .key' <<< "$cfg" | grep . || echo "$1"; }
  bad=""
  while read -r svc nets; do
    c=$(awk -F'\t' -v s="$svc" '$1 == s { print $2; exit }' <<< "$rows")
    if [ -z "$c" ]; then bad+=" $svc:no-container"; continue; fi
    got=$(for name in $(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$c"); do netkey "$name"; done | sort | tr '\n' ' ')
    want=$(tr ' ' '\n' <<< "$nets" | sed '/^$/d' | sort | tr '\n' ' ')
    [ "$got" = "$want" ] || bad+=" $svc:[$got] want [$want]"
  done < <(expected "$repo/spike/expected/networks.txt")
  check J-1 "every base container is on exactly its §4.12 networks (offenders:${bad:- none})" test -z "$bad"
  bad=$(base_services | grep -vxF -f <(expected "$repo/spike/expected/networks.txt" | awk '{ print $1 }') | tr '\n' ' ')
  check J-1 "the expected table covers every base service (missing: ${bad:-none})" test -z "$bad"
  # The other direction: every container attached to idp or data is one the table puts there.
  bad=""
  for net in idp data; do
    name=$(jq -r --arg n "$net" '.networks[$n].name' <<< "$cfg")
    for c in $(docker network inspect -f '{{range $id, $e := .Containers}}{{$id}} {{end}}' "$name" 2> /dev/null); do
      svc=$(awk -F'\t' -v c="$c" 'index(c, $2) == 1 { print $1; exit }' <<< "$rows")
      if [ -z "$svc" ] || ! expected "$repo/spike/expected/networks.txt" | awk -v s="$svc" -v n="$net" '$1 == s { for (i = 2; i <= NF; i++) if ($i == n) f = 1 } END { exit !f }'; then
        bad+=" $net:$(docker inspect -f '{{.Name}}' "$c" | tr -d /)"
      fi
    done
  done
  check J-1 "idp and data hold only the containers the table puts there (intruders:${bad:- none})" test -z "$bad"
  bad=""
  for net in edge idp services data ops; do
    name=$(jq -r --arg n "$net" '.networks[$n].name' <<< "$cfg")
    internal=$(docker network inspect -f '{{.Internal}}' "$name" 2> /dev/null)
    case $net in idp | data) want_int=true ;; *) want_int=false ;; esac
    [ "$internal" = "$want_int" ] || bad+=" $net:${internal:-missing}"
  done
  check J-1 "the five networks exist; idp and data are internal, the others not (offenders:${bad:- none})" test -z "$bad"
}

# A-1's object listings, one labelled block each, sorted so two runs compare as text.
objects_listing() {
  echo "## databases"; psql_su "select datname from pg_database order by 1"
  echo "## roles"; psql_su "select rolname from pg_roles where rolname !~ '^pg_' order by 1"
  echo "## topics"; kafka_sh kafka-topics.sh --command-config /tmp/kafka/admin.properties --list 2> /dev/null | sort
  echo "## kafka users"; kafka_sh kafka-configs.sh --command-config /tmp/kafka/admin.properties \
    --describe --entity-type users 2> /dev/null | sed -E "s/^SCRAM credential configs for user-principal '([^']+)'.*/\1/" | sort
  echo "## acls"; kafka_sh kafka-acls.sh --command-config /tmp/kafka/admin.properties --list 2> /dev/null |
    sed -nE 's/.*resourceType=([A-Z]+), name=([^,]+), patternType=([A-Z]+)\).*/\1 \3 \2/p; s/.*\(principal=([^,]+), host=([^,]+), operation=([A-Z_]+), permissionType=([A-Z]+)\).*/  \1 \3 \4/p' |
    awk '/^[A-Z]/ { r = $0; next } { print r $0 }' | sort
  echo "## connectors"; connect_api GET /connectors 2> /dev/null | jq -c 'sort'
  echo "## keycloak"
  # The admin password goes through KC_CLI_PASSWORD inside the container, never a command line.
  dc exec -T keycloak bash -c '
    c=$(mktemp); kc=/opt/keycloak/bin/kcadm.sh
    KC_CLI_PASSWORD=$(< /run/secrets/keycloak-admin) "$kc" config credentials --config "$c" \
      --server http://127.0.0.1:8080 --realm master --user admin > /dev/null 2>&1 || { echo "kcadm sign-in failed"; exit 1; }
    "$kc" get realms --config "$c" --fields realm; "$kc" get organizations -r setpiece --config "$c" --fields alias
    "$kc" get users -r setpiece --config "$c" --fields username; rc=$?; rm -f "$c"; exit $rc' 2> /dev/null |
    jq -r '.[] | if .realm then "realm \(.realm)" elif .alias then "organization \(.alias)" else "user \(.username)" end' | sort
}
# Base container ids by name, and the names of long-running base containers that aren't healthy.
base_ids() { docker compose -f "$repo/compose.base.yaml" ps -a --format '{{.Name}} {{.ID}}' | sort; }
unhealthy() {
  local svc c v
  for svc in $(expected "$repo/platform/services.txt"); do
    c=$(dc ps -q "$svc" | head -1)
    v=$( [ -n "$c" ] && docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$c")
    [ "$v" = healthy ] || echo "$svc:${v:-missing}"
  done | tr '\n' ' '
}

# A-1: scripts/up, then again. Both times every long-running container is healthy; the second run
# recreates nothing, and no database, role, topic, user, ACL, connector or realm object changes.
section_up_twice() {
  local d i1 i2 o1 o2 u run empty dups
  d=$(mktemp -d)
  for run in 1 2; do
    if ! (cd "$repo" && scripts/up) > "$d/up$run.log" 2>&1; then
      fail A-1 "scripts/up run $run failed: $(tail -3 "$d/up$run.log" | tr '\n' ' ')"; rm -rf "$d"; return
    fi
    u=$(unhealthy)
    check A-1 "after scripts/up run $run every long-running container is healthy (not healthy: ${u:-none})" test -z "$u"
    base_ids > "$d/ids$run"
    objects_listing > "$d/obj$run"
  done
  i1=$(wc -l < "$d/ids1"); o1=$(grep -c . "$d/obj1"); i2=$(diff "$d/ids1" "$d/ids2" | grep -c '^[<>]'); o2=$(diff "$d/obj1" "$d/obj2" | grep '^[<>]' | head -5 | tr '\n' ' ')
  check A-1 "the second run recreated none of the $i1 base containers ($i2 id lines differ)" test "$i1" -gt 0 -a "$i2" -eq 0
  # Every listing but connectors (none in the base stack) must have read something.
  empty=$(awk '/^## / { if (b != "" && b != "connectors" && n == 0) print b; b = substr($0, 4); n = 0; next }
    $0 != "" && $0 != "[]" { n++ } END { if (b != "connectors" && n == 0) print b }' "$d/obj2" | tr '\n' ',')
  dups=$(awk '/^## / { b = $0; next } { print b "\t" $0 }' "$d/obj2" | sort | uniq -d | tr '\n' ' ')
  check A-1 "no object changed or doubled across the second run ($o1 listing lines; empty listings: ${empty:-none}; doubled: ${dups:-none}; diff: ${o2:-none})" \
    test -z "$empty" -a -z "$o2" -a -z "$dups"
  echo "        objects after run 2:"; awk '{ print "          " $0 }' "$d/obj2"
  rm -rf "$d"
}

# A-6: memory. docker stats for every running container of the project, with the host's free -m
# now and, when `all` recorded it, before bring-up.
section_stats() {
  local out n ids
  [ -n "${free_before:-}" ] && { echo "        free -m before bring-up:"; awk '{ print "          " $0 }' <<< "$free_before"; }
  echo "        free -m now:"; free -m | sed 's/^/          /'
  mapfile -t ids < <(dc ps -q)
  n=${#ids[@]}
  out=$( [ "$n" -gt 0 ] && docker stats --no-stream --format '{{.Name}} {{.MemUsage}} {{.CPUPerc}}' "${ids[@]}" 2>&1)
  awk '{ print "        " $0 }' <<< "$out"
  check A-6 "docker stats recorded for all $n running containers of the project" \
    test "$n" -gt 0 -a "$(grep -c 'iB' <<< "$out")" -eq "$n"
}

section_telemetry() {
  local col hm lg c n u m v t secs logopts
  col=$(cid_of otel-collector); hm=$(cid_of otel-hostmetrics); lg=$(cid_of otel-lgtm)
  if [ -z "$col" ] || [ -z "$hm" ] || [ -z "$lg" ]; then
    t=$( (cd "$repo" && scripts/up) 2>&1 | tail -3 | tr '\n' ' ')
    col=$(cid_of otel-collector); hm=$(cid_of otel-hostmetrics); lg=$(cid_of otel-lgtm)
  fi
  if [ -z "$col" ] || [ -z "$hm" ] || [ -z "$lg" ]; then
    fail I-1 "otel-collector, otel-hostmetrics and otel-lgtm are not all running after scripts/up (${t:-})"
    return
  fi
  insp() { docker inspect -f "$2" "$1"; }
  caps_none() { [ "$1" = '["ALL"] null' ] || [ "$1" = '["ALL"] []' ]; }
  # Network names without the project prefix, sorted, space-separated.
  # shellcheck disable=SC2016
  nets() { insp "$1" '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' | tr ' ' '\n' | sed -E '/^$/d; s/.*_//' | sort | tr '\n' ' '; }

  # I-1: the OTel Collector.
  n=$(nets "$col")
  check I-1 "otel-collector is on services and ops only ($n)" test "$n" = "ops services "
  u=$(insp "$col" '{{.Config.User}}')
  check I-1 "otel-collector runs as a non-root uid ($u)" bash -c "[[ '$u' =~ ^[1-9][0-9]*(:[0-9]+)?$ ]]"
  c=$(insp "$col" '{{json .HostConfig.CapDrop}} {{json .HostConfig.CapAdd}}')
  check I-1 "otel-collector drops ALL capabilities and adds none ($c)" caps_none "$c"
  m=$(insp "$col" '{{range .Mounts}}{{.Type}}:{{.Source}}:{{.Destination}} {{end}}')
  check I-1 "otel-collector's only mount is its config file ($m)" \
    bash -c "[[ '$m' =~ ^bind:[^\ ]*/otel/collector\.yaml:/etc/otelcol-contrib/config\.yaml\ $ ]]"
  # shellcheck disable=SC2016
  t=$(insp "$col" '{{range $p, $b := .NetworkSettings.Ports}}{{range $b}}{{$p}}={{.HostIp}}:{{.HostPort}} {{end}}{{end}}')
  check I-1 "otel-collector publishes fluent-forward on 127.0.0.1:24224 only ($t)" test "$t" = "24224/tcp=127.0.0.1:24224 "
  t=$(insp "$col" '{{.HostConfig.LogConfig.Type}}')
  check I-1 "otel-collector uses the local log driver ($t)" test "$t" = local

  # I-1: the host-metrics Collector.
  n=$(nets "$hm")
  check I-1 "otel-hostmetrics is on ops only ($n)" test "$n" = "ops "
  u=$(insp "$hm" '{{.Config.User}}')
  check I-1 "otel-hostmetrics runs as a non-root uid ($u)" bash -c "[[ '$u' =~ ^[1-9][0-9]*(:[0-9]+)?$ ]]"
  local others
  others=$(for x in $(dc ps -aq); do [ "$x" = "$hm" ] || docker inspect -f '{{.Config.User}}' "$x"; done | sed 's/:.*//' | sort -u | tr '\n' ' ')
  check I-1 "otel-hostmetrics' uid ${u%%:*} is used by no other container (others: ${others:-none})" \
    bash -c "! grep -qw -- '${u%%:*}' <<< '$others'"
  c=$(insp "$hm" '{{json .HostConfig.CapDrop}} {{json .HostConfig.CapAdd}}')
  check I-1 "otel-hostmetrics drops ALL capabilities and adds none ($c)" caps_none "$c"
  m=$(insp "$hm" '{{range .Mounts}}{{.Type}}:{{.Source}}:{{.Destination}} {{end}}')
  check I-1 "otel-hostmetrics' only mount is its config file: no /proc, Docker socket, logs or secrets ($m)" \
    bash -c "[[ '$m' =~ ^bind:[^\ ]*/otel/hostmetrics\.yaml:/etc/otelcol-contrib/config\.yaml\ $ ]]"
  t=$(insp "$hm" '{{.HostConfig.LogConfig.Type}}')
  check I-1 "otel-hostmetrics uses the fluentd log driver ($t)" test "$t" = fluentd
  t=$(insp "$lg" '{{.HostConfig.LogConfig.Type}}')
  check I-1 "otel-lgtm uses the local log driver ($t)" test "$t" = local

  # I-1: OTLP in through the Collector, out to otel-lgtm: a log record posted from the stand-in on `services`.
  m="spike-otlp-$(date +%s)-$RANDOM"
  t=$(jq -nc --arg m "$m" '{resourceLogs:[{resource:{attributes:[{key:"service.name",value:{stringValue:"spike-check"}}]},
      scopeLogs:[{logRecords:[{body:{stringValue:$m}}]}]}]}')
  c=$(dc run --rm -T stand-in wget -q -O /dev/null --header 'Content-Type: application/json' --post-data "$t" \
    http://otel-collector:4318/v1/logs 2> /dev/null && echo posted)
  if secs=$(wait_loki "$m" 60); then
    pass I-1 "OTLP log posted to otel-collector:4318 (${c:-no answer}) reached Loki in otel-lgtm in ${secs}s"
  else
    fail I-1 "OTLP log posted to otel-collector:4318 (${c:-no answer}) not in Loki after 60s"
  fi

  # I-2: every base container except the Collector and otel-lgtm uses the fluentd driver as
  # §4.10 says (check-compose checks the same in the Compose file, for CI).
  # Base containers only, one-shots included; the test overlay's own containers are not checked.
  logopts=""
  for c in $(docker compose -f "$repo/compose.base.yaml" config --services | grep -vxE 'otel-collector|otel-lgtm' |
      while read -r x; do dc ps -aq "$x"; done); do
    t=$(docker inspect -f '{{.Name}} {{.HostConfig.LogConfig.Type}} {{index .HostConfig.LogConfig.Config "fluentd-address"}} {{index .HostConfig.LogConfig.Config "fluentd-async"}} {{index .HostConfig.LogConfig.Config "mode"}} {{index .HostConfig.LogConfig.Config "max-buffer-size"}}' "$c")
    [[ $t =~ ^[^\ ]+\ fluentd\ 127\.0\.0\.1:24224\ true\ non-blocking\ [0-9]+[kmg]?$ ]] || logopts+=" ${t%% *}"
  done
  check I-2 "every other container logs to fluentd 127.0.0.1:24224, async, non-blocking, buffered (offenders:${logopts:- none})" \
    test -z "$logopts"

  # I-2: a container started while the Collector is stopped still starts, and its lines arrive later.
  m="spike-marker-$(date +%s)-$RANDOM"
  # Never leave the Collector stopped: unless-stopped would keep it down, and logs would be dropped.
  trap 'dc start otel-collector > /dev/null 2>&1' EXIT INT TERM
  dc stop otel-collector > /dev/null 2>&1
  # Five marker lines, all printed while the Collector is down, so one lost write can't decide it.
  c=$(dc run -d --rm stand-in sh -c "for i in 1 2 3 4 5; do echo $m-\$i; sleep 1; done; exec sleep 600" 2> /dev/null)
  t=$(docker inspect -f '{{.State.Status}}' "$c" 2> /dev/null)
  check I-2 "stand-in started while otel-collector was stopped (state: ${t:-not created})" test "$t" = running
  sleep 6
  dc start otel-collector > /dev/null 2>&1
  trap - EXIT INT TERM
  if secs=$(wait_loki "$m" 180); then
    pass I-2 "the stand-in's marker reached Loki ${secs}s after the Collector came back ($(loki_count "$m") of 5 lines)"
  else
    fail I-2 "the stand-in's marker was not in Loki 180s after the Collector came back"
  fi
  [ -n "$c" ] && docker rm -f "$c" > /dev/null 2>&1

  # I-3: retention, and data surviving a recreate.
  t=$(lgtm curl -s localhost:9090/api/v1/status/flags | jq -r '.data["storage.tsdb.retention.time"]')
  # Prometheus prints the flag normalised: 35d comes back as 5w.
  check I-3 "Prometheus --storage.tsdb.retention.time is 35 days ($t)" bash -c "[[ '$t' = 35d || '$t' = 5w ]]"
  t=$(lgtm curl -s localhost:3100/config | grep -E '^\s+(retention_enabled|retention_period):' | tr -s ' ' | tr '\n' ' ')
  check I-3 "Loki retention is on and 7 days ($t)" bash -c "grep -q 'retention_enabled: true' <<< '$t' && grep -Eq 'retention_period: (1w|7d|168h)' <<< '$t'"
  t=$(lgtm curl -s localhost:3200/status/config | grep -oE '[^_]block_retention: [^ ]+' | sed 's/^.//' | sort -u | tr '\n' ' ')
  check I-3 "Tempo block retention is 7 days ($t)" test "$t" = "block_retention: 168h0m0s "
  t=$(insp "$lg" '{{range .Mounts}}{{.Type}}:{{.Name}}:{{.Destination}} {{end}}')
  check I-3 "otel-lgtm keeps /data on a named volume ($t)" bash -c "grep -Eq 'volume:[^ :]+:/data( |$)' <<< '$t'"

  v=$RANDOM; local now
  now=$(date +%s)
  t=$(jq -nc --arg v "$v" --arg t "${now}000000000" '{resourceMetrics:[{resource:{attributes:[{key:"service.name",value:{stringValue:"spike-check"}}]},
      scopeMetrics:[{metrics:[{name:"spike_marker",gauge:{dataPoints:[{asDouble:($v|tonumber),timeUnixNano:$t}]}}]}]}]}')
  lgtm curl -s -o /dev/null -H 'Content-Type: application/json' -d "$t" localhost:4318/v1/metrics
  marker() {
    local r
    for _ in $(seq 1 12); do
      r=$(lgtm curl -sG localhost:9090/api/v1/query --data-urlencode query=spike_marker \
        --data-urlencode time=$((now + 1)) 2> /dev/null | jq -r '.data.result[0].value[1] // empty' 2> /dev/null)
      [ "$r" = "$v" ] && { echo "$r"; return 0; }
      sleep 5
    done
    echo "${r:-none}"; return 1
  }
  t=$(marker)
  check I-3 "marker metric spike_marker=$v stored before the recreate (read $t)" test "$t" = "$v"
  dc up -d --wait --force-recreate otel-lgtm > /dev/null 2>&1
  c=$(cid_of otel-lgtm)
  check I-3 "otel-lgtm was recreated (${lg:0:12} -> ${c:0:12})" test -n "$c" -a "$c" != "$lg"
  t=$(marker)
  check I-3 "marker metric spike_marker=$v still there after the recreate (read $t)" test "$t" = "$v"

  # I-4: Grafana on 127.0.0.1 only, anonymous off, admin password from the secret file.
  t=$(docker port "$c" 3000/tcp | tr '\n' ' ')
  check I-4 "Grafana is published on 127.0.0.1 only ($t)" bash -c "[[ '$t' =~ ^127\.0\.0\.1:[0-9]+\ $ ]]"
  local gp=${t##*:}; gp=${gp%% *}
  t=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$gp/api/org")
  check I-4 "anonymous GET /api/org is refused (HTTP $t)" test "$t" = 401
  # The password goes to curl on stdin, not in its argv where `ps` would show it.
  t=$(printf 'user = "admin:%s"\n' "$(cat "$repo/secrets/grafana-admin")" |
    curl -s -K - -o /dev/null -w '%{http_code}' "http://127.0.0.1:$gp/api/org")
  check I-4 "admin with the password in secrets/grafana-admin is accepted (HTTP $t)" test "$t" = 200
  t=$(curl -s -o /dev/null -w '%{http_code}' -u admin:admin "http://127.0.0.1:$gp/api/org")
  check I-4 "the image's default admin:admin is refused (HTTP $t)" test "$t" = 401
}

# Kafka, kafka-init and Connect (issue OUT-150; spec D-1 to D-4, K-5b). Brings the base stack up
# with scripts/up twice, so it needs the host's Docker daemon. Set COMPOSE_PROJECT_NAME to keep
# the run apart from other stacks on the host.
section_kafka() {
  local dc ids1 ids2 cid1 cid2 kadmin acls deps v leaked c out rc t1 t2 id
  dc=(docker compose --project-directory "$repo" -f "$repo/compose.base.yaml")
  kadmin=(--bootstrap-server localhost:9092 --command-config /tmp/kafka/admin.properties)
  container_ids() { "${dc[@]}" ps -q kafka connect | sort | tr '\n' ' '; }
  # Both must be listed and healthy; `ps` leaves out a container that never started.
  both_healthy() { test "$("${dc[@]}" ps --format '{{.Service}}={{.Health}}' kafka connect | sort | tr '\n' ' ')" = \
    "connect=healthy kafka=healthy "; }
  cluster_id() { "${dc[@]}" exec -T kafka sed -n 's/^cluster.id=//p' /var/lib/kafka/data/logs/meta.properties; }
  init_started() { docker inspect --format '{{.State.StartedAt}}' "$("${dc[@]}" ps -aq kafka-init)" 2> /dev/null; }

  "$repo/scripts/up" > /dev/null 2>&1
  rc=$?
  check D-1 "first scripts/up exits 0 (exit $rc)" test "$rc" -eq 0
  check D-1 "first scripts/up: kafka and connect healthy" both_healthy
  ids1=$(container_ids)
  t1=$(init_started)
  "$repo/scripts/up" > /dev/null 2>&1
  rc=$?
  check D-1 "second scripts/up exits 0 (exit $rc)" test "$rc" -eq 0
  check D-1 "second scripts/up: kafka and connect healthy" both_healthy
  ids2=$(container_ids)
  t2=$(init_started)
  check D-1 "second scripts/up recreates neither kafka nor connect" test -n "$ids1" -a "$ids1" = "$ids2"
  check D-2 "kafka-init ran again on the second run ($t1, then $t2)" test -n "$t1" -a -n "$t2" -a "$t1" != "$t2"
  check D-2 "kafka-init exited 0 on the second run" \
    test "$("${dc[@]}" ps -a --format '{{.ExitCode}}' kafka-init)" = 0

  # A restart runs start.sh again on the formatted volume (what every reboot does).
  cid1=$(cluster_id)
  "${dc[@]}" restart kafka > /dev/null 2>&1
  "${dc[@]}" up -d --wait kafka connect > /dev/null 2>&1
  cid2=$(cluster_id)
  check D-1 "a kafka restart keeps the cluster id ($cid1, then $cid2)" test -n "$cid1" -a "$cid1" = "$cid2"
  check D-1 "after the restart: kafka and connect healthy" both_healthy

  # No Kafka password in any of the three containers' environment, command or health check.
  leaked=""
  for c in kafka kafka-init connect; do
    id=$("${dc[@]}" ps -aq "$c")
    if [ -z "$id" ] || ! out=$(docker inspect --format \
      '{{json .Config.Env}}{{json .Config.Cmd}}{{json .Config.Entrypoint}}{{json .Config.Healthcheck}}' "$id"); then
      leaked+=" $c:not-inspected"
      continue
    fi
    for v in "$repo"/secrets/kafka-*; do
      grep -qF "$(cat "$v")" <<< "$out" && leaked+=" $c:${v##*/}"
    done
  done
  check D-1 "no Kafka password in docker inspect of kafka, kafka-init, connect (leaks:${leaked:- none})" test -z "$leaked"

  acls=$("${dc[@]}" exec -T kafka /opt/kafka/bin/kafka-acls.sh "${kadmin[@]}" --list |
    sed -nE 's/.*resourceType=([A-Z]+), name=([^,]+), patternType=([A-Z]+)\).*/\1 \3 \2/p
      s/.*\(principal=([^,]+), host=([^,]+), operation=([A-Z_]+), permissionType=([A-Z]+)\).*/  \1 \2 \3 \4/p
      t; /principal=/s/.*/  UNPARSED &/p' |
    awk '/^  / { $1 = $1; print res, $0; next } { res = $0 }' | LC_ALL=C sort)
  if diff <(LC_ALL=C sort "$repo/spike/expected/kafka-acls.txt") <(printf '%s\n' "$acls") > /dev/null; then
    pass D-2 "ACL list equals spike/expected/kafka-acls.txt ($(wc -l <<< "$acls") entries)"
  else
    fail D-2 "ACL list differs from spike/expected/kafka-acls.txt:"
    diff <(LC_ALL=C sort "$repo/spike/expected/kafka-acls.txt") <(printf '%s\n' "$acls") | sed 's/^/        /'
  fi
  out=$("${dc[@]}" exec -T kafka /opt/kafka/bin/kafka-configs.sh "${kadmin[@]}" --describe --entity-type users)
  for v in admin connect connect-producer svc-collector svc-spike; do
    check D-2 "SCRAM-SHA-512 user $v exists" grep -q "user-principal '$v' are SCRAM-SHA-512" <<< "$out"
  done
  out=$("${dc[@]}" exec -T kafka /opt/kafka/bin/kafka-topics.sh "${kadmin[@]}" --describe --topic ev.spike.example)
  check D-2 "ev.spike.example has 3 partitions" grep -q 'PartitionCount: 3' <<< "$out"

  deps=$("${dc[@]}" config --format json)
  check D-2 "kafka-init depends on kafka healthy" \
    test "$(jq -r '.services["kafka-init"].depends_on.kafka.condition' <<< "$deps")" = service_healthy
  check D-3 "connect depends on kafka-init completed successfully" \
    test "$(jq -r '.services.connect.depends_on["kafka-init"].condition' <<< "$deps")" = service_completed_successfully
  check D-4 "connect is on the data network only" \
    test "$(jq -r '.services.connect.networks | keys | join(",")' <<< "$deps")" = data

  out=$("${dc[@]}" exec -T connect curl -fsS http://localhost:8083/connector-plugins)
  check D-4 "GET /connector-plugins lists the Postgres connector" \
    grep -q '"io.debezium.connector.postgresql.PostgresConnector"' <<< "$out"
  local w="$repo/connect/worker.properties" bad=""
  for v in 'config.providers=dir' \
    'config.providers.dir.class=org.apache.kafka.common.config.provider.DirectoryConfigProvider' \
    'connector.client.config.override.policy=None' \
    'producer.delivery.timeout.ms=2147483647' 'producer.retries=2147483647' \
    'config.storage.replication.factor=1' 'offset.storage.replication.factor=1' 'status.storage.replication.factor=1'; do
    grep -qxF "$v" "$w" || bad+=" $v"
  done
  for v in 'sasl.jaas' 'consumer.sasl.jaas' 'admin.sasl.jaas'; do
    grep -qE "^$v.config=.*username=\"connect\" password=\"\\$\{dir:/run/secrets:kafka-connect\}\";$" "$w" || bad+=" $v"
  done
  grep -qE '^producer.sasl.jaas.config=.*username="connect-producer" password="\$\{dir:/run/secrets:kafka-connect-producer\}";$' "$w" ||
    bad+=" producer.sasl.jaas"
  check D-4 "worker config settings (missing:${bad:- none})" test -z "$bad"

  # K-5b: from a container on `services`, 9092 answers and the controller port 9093 doesn't.
  docker compose --project-directory "$repo" -f "$repo/compose.base.yaml" -f "$repo/spike/compose.spike.yaml" \
    up -d --wait stand-in > /dev/null 2>&1
  local sdc=(docker compose --project-directory "$repo" -f "$repo/compose.base.yaml" -f "$repo/spike/compose.spike.yaml")
  check K-5b "stand-in on services reaches kafka:9092" "${sdc[@]}" exec -T stand-in nc -w 2 kafka 9092 < /dev/null
  check K-5b "stand-in on services cannot reach kafka:9093" \
    bash -c "! $(printf '%q ' "${sdc[@]}") exec -T stand-in nc -w 2 kafka 9093 < /dev/null"
}

# jq as a test on stdin: exit status only.
jqin() { jq -e "$@" > /dev/null; }

# Decode one base64url JWT part to JSON.
jwt_part() { local p; p=$(cut -d. -f"$2" <<< "$1" | tr '_-' '/+'); while [ $((${#p} % 4)) -ne 0 ]; do p+="="; done; base64 -d <<< "$p"; }

# K-4, E-1, E-2 and B-5 for Keycloak, against the running stack.
section_k4() {
  local id nets idp d token header claims tenant probe
  id=$(dc ps -q keycloak)
  if [ -z "$id" ]; then fail K-4 "keycloak is not running (run scripts/up first)"; return; fi

  nets=$(docker inspect "$id" --format '{{json .NetworkSettings.Networks}}' | jq -r 'keys[]')
  idp=$(grep -E '_idp$' <<< "$nets" || true)
  check E-2 "keycloak's networks: $(tr '\n' ' ' <<< "$nets")(idp only)" \
    test "$(wc -l <<< "$nets")" -eq 1 -a -n "$idp"
  check B-5 "keycloak is healthy with its passwords from files, none in its environment or command" bash -c \
    "[ \"\$(docker inspect '$id' --format '{{.State.Health.Status}}')\" = healthy ] &&
     ! docker inspect '$id' --format '{{json .Config.Env}} {{json .Config.Cmd}} {{json .Config.Entrypoint}}' |
       grep -Eq 'KC_DB_PASSWORD|KC_BOOTSTRAP_ADMIN_PASSWORD'"

  # The test user's password: never committed (E-1), written here under the B-2 rules.
  d=$(mktemp -d)
  tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32 > "$d/pw"
  chmod 0444 "$d/pw"
  if ! dc exec -T keycloak bash -c '
      pw=$(cat); c=$(mktemp)
      kc=/opt/keycloak/bin/kcadm.sh
      # Passwords through KC_CLI_PASSWORD, never on a command line the host can read with ps.
      KC_CLI_PASSWORD=$(< /run/secrets/keycloak-admin) "$kc" config credentials --config "$c" \
        --server http://127.0.0.1:8080 --realm master --user admin &&
      KC_CLI_PASSWORD=$pw "$kc" set-password --config "$c" -r setpiece --username spike-user
      rc=$?; rm -f "$c"; exit $rc' < "$d/pw" > "$d/kcadm.log" 2>&1; then
    fail E-1 "kcadm.sh could not set the test user's password: $(tail -1 "$d/kcadm.log")"
    rm -rf "$d"; return
  fi
  pass E-1 "test user's password set with kcadm.sh from a secret file (not in realm.json)"
  check E-1 "realm.json holds no credentials" bash -c "! jq -e '[.. | objects | select(has(\"credentials\") or has(\"secret\"))] | length > 0' '$repo/keycloak/realm.json' > /dev/null"

  # The token, from the probe image attached to idp only.
  probe=$(dc --profile probe config --format json | jq -r '.services.probe.image')
  token=$(docker run --rm --network "$idp" --user 65532:65532 --read-only --cap-drop ALL \
      --security-opt no-new-privileges:true -v "$d/pw:/run/pw:ro" "$probe" -sS --fail-with-body \
      -d grant_type=password -d client_id=edge -d username=spike-user --data-urlencode password@/run/pw \
      http://keycloak:8080/realms/setpiece/protocol/openid-connect/token | jq -r '.access_token // empty')
  rm -rf "$d"
  if [ -z "$token" ]; then fail K-4 "no access token from the edge client"; return; fi
  header=$(jwt_part "$token" 1)
  claims=$(jwt_part "$token" 2)
  tenant=$(jq -r '.organizations[] | select(.alias == "spike") | .attributes.tenant_id[0]' "$repo/keycloak/realm.json")
  echo "        header: $(jq -c . <<< "$header")"
  echo "        claims: $(jq -c '{aud, client_id, azp, organization}' <<< "$claims")"
  check K-4 "header typ is at+jwt" jqin '.typ == "at+jwt"' <<< "$header"
  check K-4 "aud holds the edge client" jqin '[.aud] | flatten | index("edge") != null' <<< "$claims"
  check K-4 "client_id is edge" jqin '.client_id == "edge"' <<< "$claims"
  check K-4 "tenant_id is exactly the organisation's attribute ($tenant)" \
    jqin --arg t "$tenant" '.organization.spike.tenant_id == [$t]' <<< "$claims"
}

[ $# -gt 0 ] || { sed -n '2,8p' "$0"; exit 2; }
if [ "$1" = k1 ] && [ "${2:-}" = --from ]; then
  [ $# -eq 5 ] || { echo "usage: scripts/spike-check k1 --from <label> <kong address> <this device's LAN address>" >&2; exit 2; }
  echo "== k1 --from $3"; section_k1_from "$3" "$4" "$5"; exit "$failed"
fi
for s in "$@"; do
  fn="section_${s//-/_}"
  if declare -F "$fn" > /dev/null; then echo "== $s"; "$fn"; else echo "unknown section: $s" >&2; exit 2; fi
done
exit "$failed"
