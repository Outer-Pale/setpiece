#!/usr/bin/env bash
# The only way to start the platform. Safe to run any number of times.
# Design checkpoint §4.10 ("scripts/up is the only way to start the platform").
set -euo pipefail
cd "$(dirname "$0")/.."

# The Compose version step 1 proved on the target host (spec A-5).
COMPOSE_VERSION=5.5.1

found=$(docker compose version --short 2> /dev/null || true)
found=${found#v}
if [ "$found" != "$COMPOSE_VERSION" ]; then
  echo "scripts/up: needs Docker Compose $COMPOSE_VERSION, found '${found:-none}'" >&2
  exit 1
fi

# 1. Secrets, on the host.
scripts/secrets-init

base=(-f compose.base.yaml)
all=("${base[@]}")
[ -f compose.services.yaml ] && all+=(-f compose.services.yaml)

# 2. Postgres and OpenFGA from the base file only, then fga-init once a model exists.
#    openfga-migrate and pg-init run as their dependencies and are never named (§4.10).
docker compose "${base[@]}" up -d --wait postgres openfga
if [ -f fga/fga.mod ]; then
  docker compose "${base[@]}" run --rm fga-init
fi

# 3. Every long-running service, named so one-shot containers are never waited on.
services=()
while IFS= read -r s || [ -n "$s" ]; do
  s=${s%%#*}
  s=${s//[[:space:]]/}
  [ -n "$s" ] && services+=("$s")
done < platform/services.txt
if [ ${#services[@]} -gt 0 ]; then
  docker compose "${all[@]}" up -d --wait "${services[@]}"
fi
